{
  "_about": "Tokens No Contact Tracker — thème sombre par défaut (usage la nuit, moments de crise). Rôles mesurés en recon, valeurs à valider sur captures (replica/screens/). accent et panic sont des placeholders neutres : /replica-brand les remplace. Light : tokens.light.json, mêmes rôles.",
  "theme": "dark",
  "color": {
    "bg": "#0e1014",
    "surface": "#161a21",
    "surface-2": "#1f242d",
    "border": "#2a303b",
    "border-input": "#6f7988",
    "text": "#f2f4f7",
    "text-muted": "#a3acba",
    "text-subtle": "#8a93a2",
    "accent": "#8e9bff",
    "on-accent": "#0e1014",
    "panic": "#ff8f6b",
    "on-panic": "#0e1014",
    "danger": "#ff6b6b",
    "on-danger": "#0e1014",
    "success": "#4ade80",
    "warning": "#fbbf24",
    "focus": "#8e9bff",
    "mood-1": "#f87171",
    "mood-2": "#fb923c",
    "mood-3": "#facc15",
    "mood-4": "#a3e635",
    "mood-5": "#4ade80"
  },
  "pairs": [
    ["text", "bg"], ["text", "surface"], ["text", "surface-2"],
    ["text-muted", "bg"], ["text-muted", "surface"], ["text-muted", "surface-2"],
    ["text-subtle", "bg"], ["text-subtle", "surface"],
    ["on-accent", "accent"], ["accent", "bg"], ["accent", "surface"],
    ["on-panic", "panic"], ["panic", "bg"],
    ["on-danger", "danger"], ["danger", "bg"], ["danger", "surface"],
    ["success", "bg"], ["success", "surface"], ["warning", "bg"], ["warning", "surface"],
    ["border-input", "bg", "ui"], ["border-input", "surface", "ui"],
    ["focus", "bg", "ui"], ["focus", "surface", "ui"],
    ["mood-1", "surface", "ui"], ["mood-2", "surface", "ui"], ["mood-3", "surface", "ui"],
    ["mood-4", "surface", "ui"], ["mood-5", "surface", "ui"]
  ],
  "font": {
    "sans": "Inter",
    "display": "Inter",
    "mono": "JetBrains Mono",
    "_note": "Open fonts (OFL). Le compteur utilise les chiffres tabulaires (fontVariant tabular-nums)."
  },
  "type": {
    "xs":      {"size": 12, "line": 16, "weight": 500},
    "sm":      {"size": 14, "line": 20, "weight": 400},
    "base":    {"size": 16, "line": 24, "weight": 400},
    "lg":      {"size": 18, "line": 26, "weight": 600},
    "xl":      {"size": 22, "line": 28, "weight": 700},
    "2xl":     {"size": 28, "line": 34, "weight": 700},
    "display": {"size": 40, "line": 44, "weight": 800},
    "counter": {"size": 72, "line": 76, "weight": 800}
  },
  "space": [0, 2, 4, 6, 8, 12, 16, 20, 24, 28, 32, 40, 48, 56, 64, 80, 96],
  "layout": {
    "screen-gutter": 20,
    "tab-bar-height": 64,
    "header-height": 56,
    "touch-min": 48,
    "panic-button": 64,
    "max-content-width": 560
  },
  "radius": {"sm": 8, "md": 14, "lg": 20, "xl": 28, "pill": 999},
  "shadow": {
    "card": "0 1px 2px rgba(0,0,0,.30)",
    "pop": "0 16px 40px rgba(0,0,0,.45)",
    "panic-glow": "0 0 0 8px rgba(255,143,107,.18)"
  },
  "motion": {
    "fast": "120ms",
    "base": "220ms",
    "slow": "400ms",
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "breath-box": [4000, 4000, 4000, 4000],
    "breath-478": [4000, 7000, 8000, 0],
    "breath-calm": [4000, 0, 6000, 0],
    "_note": "Respiration : inspirer, tenir, expirer, tenir (ms). Respecter Reduce Motion : l'animation devient un fondu + compte texte."
  }
}
